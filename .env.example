DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/saas_project?schema=public"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

APP_NAME="Acme Inc"
APP_URL="http://localhost:3000"

# Email (optional in dev - if SMTP_HOST is empty, emails are logged to the server console)
# See README section 16 for how to get SMTP credentials from Gmail/Mailtrap/SendGrid/SES/etc.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="Acme Inc <no-reply@example.com>"

# Google OAuth (optional) - see README section 14
# Get credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Apple OAuth (optional) - see README section 15
# Requires a paid Apple Developer account + a live HTTPS URL (localhost not supported).
# Generate AUTH_APPLE_SECRET (a JWT) with: npx auth add apple
# Redirect URI: https://your-domain.com/api/auth/callback/apple
# AUTH_APPLE_ID="com.example.app.signin"
# AUTH_APPLE_SECRET=""
